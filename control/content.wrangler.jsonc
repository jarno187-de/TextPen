{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "textpen-content",
  "main": "../.build/content-worker.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "assets": { "directory": "../.build/public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" }
}
